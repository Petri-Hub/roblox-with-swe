# Local values. The Publish workflow reads the staging and production
# values from GitHub Environments under ROBLOX_OPEN_CLOUD_API_KEY,
# ROBLOX_UNIVERSE_ID, and ROBLOX_PLACE_ID.

# Regression tests
JEST_ROBLOX_OPEN_CLOUD_API_KEY=your-open-cloud-api-key
JEST_ROBLOX_UNIVERSE_ID=1234567890
JEST_ROBLOX_PLACE_ID=987654321098

# Staging playtest (GitHub Environment: staging)
STAGING_ROBLOX_OPEN_CLOUD_API_KEY=your-staging-open-cloud-api-key
STAGING_ROBLOX_UNIVERSE_ID=10773172516
STAGING_ROBLOX_PLACE_ID=112768229129661

# Production game (GitHub Environment: production)
PRODUCTION_ROBLOX_OPEN_CLOUD_API_KEY=your-production-open-cloud-api-key
PRODUCTION_ROBLOX_UNIVERSE_ID=10773173124
PRODUCTION_ROBLOX_PLACE_ID=138015860615681
