        "EnvironmentDiffuseScale": 0.15,
        "EnvironmentSpecularScale": 0.15,
        "ExposureCompensation": 0,
        "GlobalShadows": true,
        "OutdoorAmbient": [0.03, 0.025, 0.02],
        "Outlines": false,
        "ShadowSoftness": 0.4,
