{
  "name": "roblox-with-swe",
  "tree": {
    "$className": "DataModel",
    "Workspace": {
      "$properties": {
        "FilteringEnabled": true,
        "StreamingEnabled": false
      },
      "Ground": {
        "$className": "Part",
        "$properties": {
          "Anchored": true,
          "BottomSurface": "Smooth",
          "Color": [0.11, 0.09, 0.08],
          "Material": "Slate",
          "Position": [0, -3, 0],
          "Size": [512, 4, 512],
          "TopSurface": "Smooth"
        }
      }
    },
    "Lighting": {
      "$properties": {
        "Technology": "Future"
      }
    },
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "ServerStorage": {
      "Lighting": {
        "$path": "src/assets/lighting"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    }
  }
}
