{
  "name": "roblox-with-swe-tests",
  "tree": {
    "$className": "DataModel",
    "Workspace": {
      "Baseplate": {
        "$className": "Part",
        "$properties": {
          "Anchored": true,
          "Position": [
            0,
            -2,
            0
          ],
          "Size": [
            512,
            4,
            512
          ]
        }
      }
    },
    "ServerScriptService": {
      "$properties": {
        "LoadStringEnabled": true
      },
      "TestProject": {
        "$className": "Folder",
        "Specs": {
          "$path": "tests/specs"
        },
        "DevPackages": {
          "$path": "DevPackages"
        }
      }
    }
  }
}
